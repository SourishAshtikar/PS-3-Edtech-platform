generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("student") // "student" or "faculty"
  xp            Int       @default(0)
  streak        Int       @default(0)
  lastActiveDate DateTime?
  googleAccessToken  String?  @db.Text
  googleRefreshToken String?  @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt


  progress           StudentProgress[]
  userBadges         UserBadge[]
  quizAttempts       QuizAttempt[]
  simulationProgress SimulationProgress[]
  subjectEnrollments SubjectEnrollment[]
}



model Subject {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  enrollments SubjectEnrollment[]
  resources   Resource[]
}

model SubjectEnrollment {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  xp        Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([subjectId])
}

model Module {
  id          String   @id @default(cuid())
  subjectId   String
  moduleNo    Int
  title       String
  hours       Int
  co          String
  description String

  subject            Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subtopics          Subtopic[]
  simulations        Simulation[]
  quizzes            Quiz[]
  studentProgress    StudentProgress[]

  @@index([subjectId])
}

model Subtopic {
  id              String   @id @default(cuid())
  moduleId        String
  subtopicNo      String
  title           String
  description     String
  videoUrl              String?
  notesUrl              String?
  notesDownloadUrl      String?
  quizFileUrl           String?
  quizFileDownloadUrl   String?
  mindMapUrl            String?
  mindMapDownloadUrl    String?
  flashCardsUrl         String?
  flashCardsDownloadUrl String?
  referenceUrl          String?
  referenceDownloadUrl  String?
  otherUrl              String?
  otherDownloadUrl      String?
  simulationUrl         String?
  learningOutcome       String?

  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  simulations     Simulation[]
  quizzes         Quiz[]

  @@index([moduleId])
}

model Simulation {
  id              String   @id @default(cuid())
  moduleId        String
  subtopicId      String?
  title           String
  description     String
  difficulty      String
  xpReward        Int
  estimatedTime   String?
  learningOutcome String?
  frontendUrl     String?

  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  subtopic        Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  progress        SimulationProgress[]

  @@index([moduleId])
  @@index([subtopicId])
}

model SimulationProgress {
  id           String   @id @default(cuid())
  userId       String
  simulationId String
  completed    Boolean  @default(false)
  xpEarned     Int      @default(0)
  createdAt    DateTime @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([simulationId])
}

model Quiz {
  id          String   @id @default(cuid())
  moduleId    String
  subtopicId  String?
  title       String
  difficulty  String
  timeLimit   Int // in minutes
  xpReward    Int
  documentUrl String?

  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  subtopic    Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  questions   Question[]
  attempts    QuizAttempt[]

  @@index([moduleId])
  @@index([subtopicId])
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  questionText  String
  options       String[]
  correctAnswer String // "A", "B", "C", "D"
  marks         Int      @default(1)
  explanation   String?
  difficulty    String?

  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  quizId     String
  score      Int      @default(0)
  totalMarks Int
  xpEarned   Int      @default(0)
  completed  Boolean  @default(false)
  answersData Json?   // Multiset of { questionId, selectedOption, isCorrect }
  createdAt  DateTime @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}



model Flashcard {
  id        String   @id @default(cuid())
  question  String
  answer    String
  createdAt DateTime @default(now())
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  condition   String // "Complete Module 1", "Earn 1000 XP"

  userBadges  UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  dateEarned DateTime @default(now())

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([badgeId])
}

model StudentProgress {
  id                 String   @id @default(cuid())
  userId             String
  moduleId           String
  completedSubtopics String[] // Array of completed subtopic IDs
  completedResources String[] @default([]) // Array of unique resource completions, e.g. "subtopicId-notes"
  completed          Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module             Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId])
}

model Resource {
  id        String   @id @default(cuid())
  subjectId String?
  title     String
  type      String   // "paper" or "book"
  link      String   // Google Drive Link
  detail    String?  // Year/Semester or Edition/Author details
  createdAt DateTime @default(now())

  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
}
